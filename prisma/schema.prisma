generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════════
// 1. Table Utilisateurs (Synchro Microsoft Entra ID + Panneau Admin)
// ═══════════════════════════════════════════════════════════════
model Utilisateur {
  id             String    @id @default(cuid())
  azureId        String?   @unique @map("azure_id")
  nom            String    @map("nom")
  email          String    @unique @map("email")
  role           String    @default("EMPLOYE") @map("role") // EMPLOYE, MANAGER, RH, ADMIN
  emailManager   String?   @default("") @map("email_manager") // Email du supérieur hiérarchique N+1
  estRH          Boolean   @default(false) @map("est_rh")
  estCom         Boolean   @default(false) @map("est_com") // Autorisation publication actualités SharePoint
  estDRH         Boolean   @default(false) @map("est_drh")
  estRHPrint     Boolean   @default(false) @map("est_rh_print")
  estGestionnaireSalle Boolean @default(false) @map("est_gestionnaire_salle")
  departement    String?   @map("departement")
  poste          String?   @map("poste")
  creeLe         DateTime  @default(now()) @map("cree_le")
  misAJourLe     DateTime  @updatedAt @map("mis_a_jour_le")

  demandes       Demande[] @relation("DemandesUtilisateur")

  @@map("utilisateurs")
}

// ═══════════════════════════════════════════════════════════════
// 2. Table Unique pour toutes les Demandes (Congés, IT, Salle, RH...)
// ═══════════════════════════════════════════════════════════════
model Demande {
  id                String       @id @default(cuid())
  titre             String       @map("titre")
  typeDemande       String       @map("type_demande") // "CONGE", "IT", "SALLE", "MATERIEL", "DOCUMENT_RH"
  statut            String       @default("EN_ATTENTE") @map("statut") // EN_ATTENTE, APPROUVE, REFUSE, ANNULE

  // Identité du Demandeur
  utilisateurId     String?      @map("utilisateur_id")
  utilisateur       Utilisateur? @relation("DemandesUtilisateur", fields: [utilisateurId], references: [id], onDelete: SetNull)
  emailDemandeur    String       @map("email_demandeur")
  nomDemandeur      String       @map("nom_demandeur")

  // Supérieur N+1 & Validation
  emailManager      String?      @default("") @map("email_manager")
  statutN1          String       @default("EN_ATTENTE") @map("statut_n1")
  dateValidationN1  DateTime?    @map("date_validation_n1")
  commentaireN1     String?      @map("commentaire_n1")

  // Validation RH / Admin
  statutRH          String       @default("EN_ATTENTE") @map("statut_rh")
  dateValidationRH  DateTime?    @map("date_validation_rh")
  commentaireRH     String?      @map("commentaire_rh")

  // Détails génériques des formulaires
  dateDebut         DateTime?    @map("date_debut")
  dateFin           DateTime?    @map("date_fin")
  nombreJours       Float?       @map("nombre_jours")
  typeConge         String?      @map("type_conge") // paye, conge_maladie, sans_solde, etc.
  motif             String?      @db.Text @map("motif")
  pieceJointe       String?      @map("piece_jointe")

  // Données dynamiques spécifiques aux sous-formulaires (ex: IT, réservation salle, etc.)
  donneesFormulaire Json?        @map("donnees_formulaire")

  creeLe            DateTime     @default(now()) @map("cree_le")
  misAJourLe        DateTime     @updatedAt @map("mis_a_jour_le")

  @@map("demandes")
}

// ═══════════════════════════════════════════════════════════════
// 3. Table des Vidéos & Formations Intranet (Indépendante des Actualités)
// ═══════════════════════════════════════════════════════════════
model VideoIntranet {
  id           String   @id @default(cuid())
  titre        String   @map("titre")
  categorie    String   @default("Institutionnel") @map("categorie")
  duree        String?  @default("5 min 00 s") @map("duree")
  description  String?  @db.Text @map("description")
  videoUrl     String   @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  creeLe       DateTime @default(now()) @map("cree_le")
  misAJourLe   DateTime @updatedAt @map("mis_a_jour_le")

  @@map("videos_intranet")
}

// ═══════════════════════════════════════════════════════════════
// 4. Table des Salles de Réunion T-OIL
// ═══════════════════════════════════════════════════════════════
model Salle {
  id           String             @id @default(cuid())
  nom          String             @map("nom")
  code         String?            @unique @map("code")
  capacite     Int                @default(10) @map("capacite")
  emplacement  String             @default("Siège T-OIL") @map("emplacement")
  equipements  Json?              @map("equipements") // ["Écran", "Visio", "Tableau blanc"]
  estActive    Boolean            @default(true) @map("est_active")
  creeLe       DateTime           @default(now()) @map("cree_le")
  misAJourLe   DateTime           @updatedAt @map("mis_a_jour_le")

  reservations ReservationSalle[]

  @@map("salles")
}

// ═══════════════════════════════════════════════════════════════
// 5. Table des Réservations de Salles
// ═══════════════════════════════════════════════════════════════
model ReservationSalle {
  id             String   @id @default(cuid())
  salleId        String   @map("salle_id")
  salle          Salle    @relation(fields: [salleId], references: [id], onDelete: Cascade)
  titre          String   @map("titre") // Objet de la réunion
  demandeurNom   String   @map("demandeur_nom")
  demandeurEmail String   @map("demandeur_email")
  date           DateTime @map("date") // Date de la réunion (YYYY-MM-DD)
  heureDebut     String   @map("heure_debut") // HH:mm ex: "09:00"
  heureFin       String   @map("heure_fin") // HH:mm ex: "10:30"
  participants   Int?     @default(1) @map("participants")
  motif          String?  @db.Text @map("motif")
  statut         String   @default("CONFIRMEE") @map("statut") // CONFIRMEE, ANNULEE
  creeLe         DateTime @default(now()) @map("cree_le")
  misAJourLe     DateTime @updatedAt @map("mis_a_jour_le")

  @@map("reservations_salles")
}

// ═══════════════════════════════════════════════════════════════
// 6. Table des Paramètres Généraux du Système
// ═══════════════════════════════════════════════════════════════
model Parametre {
  cle         String   @id @map("cle") @db.VarChar(100)
  valeur      String   @map("valeur") @db.Text
  description String?  @map("description") @db.VarChar(255)
  misAJourLe  DateTime @default(now()) @updatedAt @map("mis_a_jour_le")

  @@map("parametres")
}
