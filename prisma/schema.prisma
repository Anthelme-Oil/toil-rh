generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════════
// 1. Table Utilisateurs (Synchro Microsoft Entra ID + Panneau Admin)
// ═══════════════════════════════════════════════════════════════
model Utilisateur {
  id             String    @id @default(cuid())
  azureId        String?   @unique @map("azure_id")
  nom            String    @map("nom")
  email          String    @unique @map("email")
  role           String    @default("EMPLOYE") @map("role") // EMPLOYE, MANAGER, RH, ADMIN
  emailManager   String?   @default("") @map("email_manager") // Email du supérieur hiérarchique N+1
  estRH          Boolean   @default(false) @map("est_rh")
  estCom         Boolean   @default(false) @map("est_com") // Autorisation publication actualités SharePoint
  estDRH         Boolean   @default(false) @map("est_drh")
  estRHPrint     Boolean   @default(false) @map("est_rh_print")
  estGestionnaireSalle Boolean @default(false) @map("est_gestionnaire_salle")
  departement    String?   @map("departement")
  poste          String?   @map("poste")
  creeLe         DateTime  @default(now()) @map("cree_le")
  misAJourLe     DateTime  @updatedAt @map("mis_a_jour_le")

  demandes       Demande[] @relation("DemandesUtilisateur")

  @@map("utilisateurs")
}

// ═══════════════════════════════════════════════════════════════
// 2. Table Unique pour toutes les Demandes
// ═══════════════════════════════════════════════════════════════
model Demande {
  id                String       @id @default(cuid())
  titre             String       @map("titre")
  
  // Types : ABSENCE, DOMICILIATION, RENOUVELLEMENT_IT, GESTION_COMPTE_IT, 
  // ATTESTATION, CONSOMMABLE, MATERIEL_IT, ACHAT, BESOIN_METIER, ACCES_SITE
  typeDemande       String       @map("type_demande")
  
  // Statuts globaux : PENDING_N1, PENDING_DRH, PENDING_RH_EXEC, PENDING_IT_MGR, PENDING_IT_EXEC, APPROUVE, REFUSE, ANNULE
  statut            String       @default("PENDING_N1") @map("statut")

  // Identité du Demandeur
  utilisateurId     String?      @map("utilisateur_id")
  utilisateur       Utilisateur? @relation("DemandesUtilisateur", fields: [utilisateurId], references: [id], onDelete: SetNull)
  emailDemandeur    String       @map("email_demandeur")
  nomDemandeur      String       @map("nom_demandeur")

  // Utilisateur Cible (Optionnel - Pour créations/suppressions de comptes)
  targetUserId      String?      @map("target_user_id")
  targetUserName    String?      @map("target_user_name")

  // Supérieur N+1 & Validation
  emailManager      String?      @default("") @map("email_manager")
  statutN1          String       @default("EN_ATTENTE") @map("statut_n1")
  dateValidationN1  DateTime?    @map("date_validation_n1")
  commentaireN1     String?      @map("commentaire_n1")

  // Validation DRH / RH
  statutRH          String       @default("EN_ATTENTE") @map("statut_rh")
  dateValidationRH  DateTime?    @map("date_validation_rh")
  commentaireRH     String?      @map("commentaire_rh")

  // Validation & Exécution IT
  statutIT          String       @default("EN_ATTENTE") @map("statut_it")
  dateValidationIT  DateTime?    @map("date_validation_it")
  commentaireIT     String?      @map("commentaire_it")
  
  // Historique complet (horodatage, rôle, action, commentaires pour impression RH)
  historiqueValidations Json?    @map("historique_validations")

  // Champs spécifiques aux formulaires standards
  dateDebut         DateTime?    @map("date_debut")
  dateFin           DateTime?    @map("date_fin")
  nombreJours       Float?       @map("nombre_jours")
  typeConge         String?      @map("type_conge")
  motif             String?      @db.Text @map("motif")
  pieceJointe       String?      @map("piece_jointe")

  // Données dynamiques supplémentaires
  donneesFormulaire Json?        @map("donnees_formulaire")

  creeLe            DateTime     @default(now()) @map("cree_le")
  misAJourLe        DateTime     @updatedAt @map("mis_a_jour_le")

  @@map("demandes")
}

// ═══════════════════════════════════════════════════════════════
// 3. Table des Vidéos & Formations Intranet (Indépendante des Actualités)
// ═══════════════════════════════════════════════════════════════
model VideoIntranet {
  id           String   @id @default(cuid())
  titre        String   @map("titre")
  categorie    String   @default("Institutionnel") @map("categorie")
  duree        String?  @default("5 min 00 s") @map("duree")
  description  String?  @db.Text @map("description")
  videoUrl     String   @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  creeLe       DateTime @default(now()) @map("cree_le")
  misAJourLe   DateTime @updatedAt @map("mis_a_jour_le")

  @@map("videos_intranet")
}

// ═══════════════════════════════════════════════════════════════
// 4. Table des Salles de Réunion T-OIL
// ═══════════════════════════════════════════════════════════════
model Salle {
  id           String             @id @default(cuid())
  nom          String             @map("nom")
  code         String?            @unique @map("code")
  capacite     Int                @default(10) @map("capacite")
  emplacement  String             @default("Siège T-OIL") @map("emplacement")
  equipements  Json?              @map("equipements") // ["Écran", "Visio", "Tableau blanc"]
  estActive    Boolean            @default(true) @map("est_active")
  creeLe       DateTime           @default(now()) @map("cree_le")
  misAJourLe   DateTime           @updatedAt @map("mis_a_jour_le")

  reservations ReservationSalle[]

  @@map("salles")
}

// ═══════════════════════════════════════════════════════════════
// 5. Table des Réservations de Salles
// ═══════════════════════════════════════════════════════════════
model ReservationSalle {
  id             String   @id @default(cuid())
  salleId        String   @map("salle_id")
  salle          Salle    @relation(fields: [salleId], references: [id], onDelete: Cascade)
  titre          String   @map("titre") // Objet de la réunion
  demandeurNom   String   @map("demandeur_nom")
  demandeurEmail String   @map("demandeur_email")
  date           DateTime @map("date") // Date de la réunion (YYYY-MM-DD)
  heureDebut     String   @map("heure_debut") // HH:mm ex: "09:00"
  heureFin       String   @map("heure_fin") // HH:mm ex: "10:30"
  participants   Int?     @default(1) @map("participants")
  motif          String?  @db.Text @map("motif")
  statut         String   @default("CONFIRMEE") @map("statut") // CONFIRMEE, ANNULEE
  creeLe         DateTime @default(now()) @map("cree_le")
  misAJourLe     DateTime @updatedAt @map("mis_a_jour_le")

  @@map("reservations_salles")
}

// ═══════════════════════════════════════════════════════════════
// 6. Table des Paramètres Généraux du Système
// ═══════════════════════════════════════════════════════════════
model Parametre {
  cle         String   @id @map("cle") @db.VarChar(100)
  valeur      String   @map("valeur") @db.Text
  description String?  @map("description") @db.VarChar(255)
  misAJourLe  DateTime @default(now()) @updatedAt @map("mis_a_jour_le")

  @@map("parametres")
}

model CalendarDayOff {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique
  name        String
  description String?
  isRecurring Boolean  @default(false)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, isActive])
  @@map("calendarDayOff")
}


//Mediatheque



model MediaDocument {
  id          Int     @id @default(autoincrement())

  // Identification
  title       String  @db.VarChar(255)
  description String? @db.Text
  objective   String? @db.Text

  // Classement
  department String  @db.VarChar(50)
  category   String? @db.VarChar(50)
  format     String  @db.VarChar(20)
  extension  String  @db.VarChar(20)

  // Fichier
  fileName String @db.VarChar(255)
  fileUrl  String @db.Text
  fileSize BigInt?

  // Version
  version           String? @db.VarChar(30)
  previousVersionId Int?
  replacedById      Int?

  // Publication
  status       String  @default("DRAFT") @db.VarChar(20)
  isPublished  Boolean @default(false)
  visibility   String  @default("PUBLIC") @db.VarChar(20)

  // Auteur
  authorId    String? @db.VarChar(255)
  authorName  String? @db.VarChar(255)
  authorEmail String? @db.VarChar(255)

  // Publication par
  publishedById    String? @db.VarChar(255)
  publishedByName  String? @db.VarChar(255)
  publishedByEmail String? @db.VarChar(255)

  // Dates
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  // Statistiques
  views     Int @default(0)
  downloads Int @default(0)

  // Tags
  tags Json?

  // Relations de version
  previousVersion  MediaDocument?  @relation("MediaDocumentPreviousVersion", fields: [previousVersionId], references: [id])
  nextVersions     MediaDocument[] @relation("MediaDocumentPreviousVersion")

  replacedBy       MediaDocument?  @relation("MediaDocumentReplacement", fields: [replacedById], references: [id])
  replacedDocuments MediaDocument[] @relation("MediaDocumentReplacement")

  @@index([department])
  @@index([category])
  @@index([format])
  @@index([status])
  @@index([visibility])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([views])
  @@index([downloads])
  @@index([department, isPublished])
  @@index([status, isPublished])

  @@map("mediaDocument")
}



enum ChannelType {
  ARTICLE
  VIDEO
  MEDIA
  INFO
  CHAT
  GROUP
  UPC
}

enum ReactionType {
  LIKE
  DISLIKE
}

model InteractionGreffe {
  id          String      @id @default(cuid())
  referId     String      // ID de l'élément (ex: ID Média, ID Article...)
  typeRefer   ChannelType
  comments    Comment[]
  reactions   Reaction[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([referId, typeRefer])
  @@index([referId, typeRefer])
}

model Comment {
  id                  String            @id @default(cuid())
  interactionGreffeId String
  interactionGreffe   InteractionGreffe @relation(fields: [interactionGreffeId], references: [id], onDelete: Cascade)
  authorName          String
  authorEmail         String?
  text                String
  createdAt           DateTime          @default(now())

  @@index([interactionGreffeId])
}

model Reaction {
  id                  String            @id @default(cuid())
  interactionGreffeId String
  interactionGreffe   InteractionGreffe @relation(fields: [interactionGreffeId], references: [id], onDelete: Cascade)
  type                ReactionType      // LIKE ou DISLIKE
  authorName          String
  authorEmail         String            // Utilisé pour identifier de manière unique l'auteur
  createdAt           DateTime          @default(now())

  @@unique([interactionGreffeId, authorEmail]) // Un utilisateur ne peut avoir qu'une seule réaction par greffe
  @@index([interactionGreffeId])
}


enum TypeAnnonce {
  INFO
  WARNING
  URGENT
}


model Actualite {
  id              String   @id @default(cuid()) @map("id")
  titre           String   @map("titre")
  description     String   @map("description") @db.Text
  contenu         String?  @map("contenu") @db.Text
  datePublication DateTime @default(now()) @map("date_publication")
  imageUrl        String?  @map("image_url")
  categorie       String?  @map("categorie")
  auteur          String?  @map("auteur")
  tempsLecture    String?  @map("temps_lecture")
  lienVersPage    String?  @map("lien_vers_page")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("actualites")
}

/**
 * Modèle pour les Annonces
 * Basé sur l'interface TypeScript: Annonce
 */
model Annonce {
  id              String      @id @default(cuid()) @map("id")
  titre           String      @map("titre")
  contenu         String      @map("contenu") @db.Text
  type            TypeAnnonce @default(INFO) @map("type")
  datePublication DateTime    @default(now()) @map("date_publication")
  lien            String?     @map("lien")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("annonces")
}

/**
 * Modèle pour les Événements
 * Basé sur l'interface TypeScript: Evenement
 */
model Evenement {
  id          String    @id @default(cuid()) @map("id")
  titre       String    @map("titre")
  dateDebut   DateTime  @map("date_debut")
  dateFin     DateTime? @map("date_fin")
  lieu        String?   @map("lieu")
  description String?   @map("description") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("evenements")
}

/**
 * Modèle pour les Vidéos
 * Basé sur la structure 'videos' dans l'interface TypeScript: ActualitesResponse
 */
model Video {
  id           String   @id @default(cuid()) @map("id")
  titre        String   @map("titre")
  categorie    String   @map("categorie")
  duree        String   @map("duree")
  date         DateTime @default(now()) @map("date")
  thumbnailUrl String   @map("thumbnail_url")
  videoUrl     String   @map("video_url")
  description  String   @map("description") @db.Text

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("videos")
}




